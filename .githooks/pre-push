#!/usr/bin/env bash
# HiveCell pre-push hook: block a push if the safety self-tests fail.
# Enabled via:  git config core.hooksPath .githooks
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
echo "pre-push: running HiveCell safety self-tests..."
if ! "$REPO_ROOT/scripts/run_selftest.sh"; then
  echo "pre-push: BLOCKED -- safety self-tests failed. Push aborted." >&2
  exit 1
fi
echo "pre-push: safety self-tests passed."

# Git LFS: upload LFS-tracked objects (*.blend) for the refs being pushed.
# Needed explicitly here because core.hooksPath=.githooks bypasses the hook
# git-lfs installs under .git/hooks. Reads the ref list from stdin (untouched
# above) and takes <remote-name> <remote-url> as "$@".
command -v git-lfs >/dev/null 2>&1 || {
  echo "pre-push: BLOCKED -- repo uses Git LFS but 'git-lfs' is not installed (https://git-lfs.com)." >&2
  exit 2
}
git lfs pre-push "$@"
